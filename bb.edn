{:paths ["src" "plugins"]
 :tasks
  {agent {:doc "Run the plugin-based LLM agent"
         :requires ([agent.cli :as cli])
         :task (apply cli/entrypoint *command-line-args*)}
  tui-build {:doc "Build the Qwen-style Ink TUI plugin"
             :task (shell "npm run tui:build")}
  test {:doc "Run the test suite"
        :extra-paths ["test"]
        :requires ([agent.test-runner :as test-runner])
        :task (test-runner/-main)}
  web {:doc "Build and start the local WebUI"
       :task (shell "npm run web")}}}
