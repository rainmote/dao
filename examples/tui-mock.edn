{:plugins
 [{:ns agent.plugins.session}
  {:ns agent.plugins.mock
   :config
   {:responses
    [{:message {:role "assistant"
                :content "TUI is ready. Ctrl+N inserts a newline; Enter submits."}
      :finish-reason "stop"
      :usage {:total_tokens 12}}]}}
  {:ns agent.plugins.runtime
   :config {:max-steps 3
            :system-prompt "Reply briefly for the offline TUI demo."}}
  {:ns agent.plugins.remote-registry}
  {:ns agent.plugins.remote-api}
  {:ns agent.plugins.tui-ink
   :config {:command ["node" "apps/tui/dist/main.js"]
            :theme "Qwen Dark"
            :shutdown-timeout-ms 1500}}]}
